{
  "name": "@raydenui/ui",
  "version": "0.10.1",
  "description": "A modern React UI component library",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./blocks": {
      "import": {
        "types": "./dist/blocks.d.ts",
        "default": "./dist/blocks/index.js"
      },
      "require": {
        "types": "./dist/blocks.d.cts",
        "default": "./dist/blocks/index.cjs"
      }
    },
    "./chart": {
      "import": {
        "types": "./dist/chart.d.ts",
        "default": "./dist/chart.js"
      },
      "require": {
        "types": "./dist/chart.d.cts",
        "default": "./dist/chart.cjs"
      }
    },
    "./motion": {
      "import": {
        "types": "./dist/motion.d.ts",
        "default": "./dist/motion/index.js"
      },
      "require": {
        "types": "./dist/motion.d.cts",
        "default": "./dist/motion/index.cjs"
      }
    },
    "./preset": {
      "import": "./dist/preset.js",
      "require": "./dist/preset.cjs"
    },
    "./icons": {
      "import": {
        "types": "./dist/icons.d.ts",
        "default": "./dist/icons.js"
      },
      "require": {
        "types": "./dist/icons.d.cts",
        "default": "./dist/icons.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./fonts.css": "./dist/fonts.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/generate-icon-catalog.mjs && node scripts/build-runtime.mjs --clean && tsup && node scripts/build-runtime.mjs && npx @tailwindcss/cli -i src/styles/globals.css -o dist/styles.css --minify",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "npx chromatic",
    "prepare": "husky",
    "docs": "pnpm --filter @raydenui/docs dev",
    "docs:build": "pnpm --filter @raydenui/docs build",
    "docs:start": "pnpm --filter @raydenui/docs start",
    "website": "pnpm --filter @raydenui/website dev",
    "website:check": "pnpm --filter @raydenui/website check",
    "icons:build": "node scripts/generate-icon-catalog.mjs",
    "check:icons": "node scripts/generate-icon-catalog.mjs --check && node scripts/check-icons.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:docs": "node scripts/check-docs-contracts.mjs",
    "registry:build": "node scripts/registry-build.mjs",
    "registry:check": "node scripts/registry-build.mjs --check",
    "registry:smoke": "node scripts/registry-smoke.mjs",
    "guidance:build": "node scripts/generate-guidance.mjs",
    "check:guidance": "node scripts/generate-guidance.mjs --check",
    "check:guidance:browser": "node scripts/check-guidance-browser.mjs",
    "check:pilots": "node scripts/check-pilots.mjs",
    "check:consumer": "node scripts/check-consumer.mjs",
    "check:docs-payload": "node scripts/check-docs-payload.mjs"
  },
  "peerDependencies": {
    "chart.js": ">=4",
    "react": ">=18",
    "react-chartjs-2": ">=5",
    "react-dom": ">=18",
    "react-hook-form": ">=7"
  },
  "peerDependenciesMeta": {
    "react-hook-form": {
      "optional": true
    },
    "chart.js": {
      "optional": true
    },
    "react-chartjs-2": {
      "optional": true
    }
  },
  "keywords": [
    "react",
    "ui",
    "components",
    "tailwind",
    "design-system",
    "react19",
    "ui-components",
    "component-library",
    "tailwindcss",
    "design-system",
    "typescript",
    "storybook",
    "accessible",
    "a11y",
    "wcag",
    "figma",
    "rayna-ui",
    "dashboard",
    "enterprise",
    "form",
    "table",
    "modal",
    "@raydenui/ai",
    "design system"
  ],
  "license": "MIT",
  "sideEffects": [
    "*.css"
  ],
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.0.1",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.2.19",
    "@storybook/addon-docs": "^10.2.19",
    "@storybook/addon-vitest": "^10.2.19",
    "@storybook/react": "^10.2.19",
    "@storybook/react-vite": "^10.2.19",
    "@tailwindcss/cli": "^4.2.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/browser-playwright": "^4.1.0",
    "@vitest/coverage-v8": "^4.1.0",
    "autoprefixer": "^10.4.27",
    "chart.js": "^4.5.1",
    "chromatic": "^15.2.0",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "playwright": "^1.58.2",
    "postcss": "^8.5.8",
    "prettier": "^3.8.1",
    "react": "^19.2.4",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.2",
    "shadcn": "4.21.0",
    "storybook": "^10.2.19",
    "tailwindcss": "^4.2.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vite": "^7.3.1",
    "vitest": "^4.1.0"
  },
  "pnpm": {
    "overrides": {
      "flatted": ">=3.4.2",
      "path-to-regexp": ">=8.4.0",
      "picomatch": ">=4.0.4",
      "brace-expansion": ">=5.0.5",
      "esbuild": ">=0.25.0",
      "yaml": ">=2.8.3"
    }
  }
}
