{
  "$schema": "../schema.json",
  "name": "ProgressCircle",
  "figmaName": "ProgressCircle",
  "description": "Circular progress indicator with default and segmented variants.",
  "anatomy": {
    "root": {
      "type": "FRAME",
      "layoutMode": "HORIZONTAL",
      "layoutAlign": "CENTER",
      "width": 64,
      "height": 64,
      "children": ["track-circle", "fill-circle", "center-content"]
    },
    "track-circle": {
      "type": "ELLIPSE",
      "width": 64,
      "height": 64,
      "stroke": "{color.grey.200}",
      "strokeWidth": 6,
      "fill": "transparent"
    },
    "fill-circle": {
      "type": "ARC",
      "width": 64,
      "height": 64,
      "stroke": "{color.primary.500}",
      "strokeWidth": 6,
      "fill": "transparent",
      "strokeCap": "ROUND"
    },
    "center-content": {
      "type": "FRAME",
      "layoutMode": "VERTICAL",
      "layoutAlign": "CENTER",
      "itemSpacing": "{spacing.0}",
      "optional": true,
      "defaultVisible": true,
      "children": ["value-text", "label-text"]
    },
    "value-text": {
      "type": "TEXT",
      "fontFamily": "{typography.fontFamily.sans}",
      "fontWeight": "{typography.fontWeight.semibold}",
      "fontSize": "{typography.fontSize.sm}",
      "fill": "{color.grey.900}",
      "textAlignHorizontal": "CENTER"
    },
    "label-text": {
      "type": "TEXT",
      "fontFamily": "{typography.fontFamily.sans}",
      "fontWeight": "{typography.fontWeight.regular}",
      "fontSize": "{typography.fontSize.xs}",
      "fill": "{color.grey.500}",
      "textAlignHorizontal": "CENTER",
      "optional": true,
      "defaultVisible": false
    }
  },
  "sizes": {
    "XS": {
      "root.width": 48,
      "root.height": 48,
      "track-circle.width": 48,
      "track-circle.height": 48,
      "track-circle.strokeWidth": 4,
      "fill-circle.width": 48,
      "fill-circle.height": 48,
      "fill-circle.strokeWidth": 4,
      "value-text.fontSize": "{typography.fontSize.xs}"
    },
    "SM": {
      "root.width": 56,
      "root.height": 56,
      "track-circle.width": 56,
      "track-circle.height": 56,
      "track-circle.strokeWidth": 5,
      "fill-circle.width": 56,
      "fill-circle.height": 56,
      "fill-circle.strokeWidth": 5,
      "value-text.fontSize": "{typography.fontSize.xs}"
    },
    "MD": {
      "root.width": 72,
      "root.height": 72,
      "track-circle.width": 72,
      "track-circle.height": 72,
      "track-circle.strokeWidth": 6,
      "fill-circle.width": 72,
      "fill-circle.height": 72,
      "fill-circle.strokeWidth": 6,
      "value-text.fontSize": "{typography.fontSize.sm}"
    },
    "LG": {
      "root.width": 90,
      "root.height": 90,
      "track-circle.width": 90,
      "track-circle.height": 90,
      "track-circle.strokeWidth": 7,
      "fill-circle.width": 90,
      "fill-circle.height": 90,
      "fill-circle.strokeWidth": 7,
      "value-text.fontSize": "{typography.fontSize.base}"
    },
    "XL": {
      "root.width": 120,
      "root.height": 120,
      "track-circle.width": 120,
      "track-circle.height": 120,
      "track-circle.strokeWidth": 8,
      "fill-circle.width": 120,
      "fill-circle.height": 120,
      "fill-circle.strokeWidth": 8,
      "value-text.fontSize": "{typography.fontSize.lg}"
    }
  },
  "variants": {
    "Default": {
      "Default": {
        "fill-circle.stroke": "{color.primary.500}"
      }
    },
    "Segmented": {
      "Default": {
        "fill-circle.strokeCap": "NONE",
        "fill-circle.strokeDashPattern": [8, 4]
      }
    }
  },
  "componentProperties": [
    {
      "name": "Variant",
      "type": "VARIANT",
      "values": ["Default", "Segmented"],
      "default": "Default"
    },
    {
      "name": "Size",
      "type": "VARIANT",
      "values": ["XS", "SM", "MD", "LG", "XL"],
      "default": "MD"
    },
    {
      "name": "Status",
      "type": "VARIANT",
      "values": ["Default"],
      "default": "Default"
    },
    {
      "name": "Progress",
      "type": "TEXT",
      "default": "60"
    },
    {
      "name": "Show Value",
      "type": "BOOLEAN",
      "default": true
    },
    {
      "name": "Show Label",
      "type": "BOOLEAN",
      "default": false
    },
    {
      "name": "Label",
      "type": "TEXT",
      "default": "Complete"
    }
  ],
  "implementationNotes": [
    "Dimensions, stroke widths, and value typography match runtime sizeConfig.",
    "label provides an accessible name, not a visible center label. The Figma label-text layer is design-only and not a runtime feature.",
    "Runtime variants are default and segmented; semantic status colors are not a public prop."
  ]
}
